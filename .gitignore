# Java/build output
*.class
build/
out/
target/
.java-build/

# Editors and operating systems
# .vscode/settings.json and .vscode/extensions.json are intentionally
# tracked -- portable DSA Focus Mode config, no machine-specific paths.
# Only files an editor might add later (e.g. a personal launch.json) would
# need their own specific ignore rule.
.idea/
.DS_Store
Thumbs.db

# Temporary and diagnostic files
*.tmp
*.bak
*.prev-*.java
integration-test/
.integration-test/
*.log
